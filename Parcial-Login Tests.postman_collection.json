  "item": [
    {
      "name": "/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test('Contiene formulario HTML', () => {\r",
              "    pm.expect(pm.response.text()).to.include('Iniciar Sesi');\r",
              "});\r",
              "pm.test('Content-Type es text/html', () => {\r",
              "    pm.expect(pm.response.headers.get('Content-Type'))\r",
              "        .to.include('text/html');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
