              "pm.test('Redirige al dashboard (302)', () => {\r",
              "    pm.response.to.have.status(302);\r",
              "});\r",
              "pm.test('Location apunta a /dashboard', () => {\r",
              "    pm.expect(pm.response.headers.get('Location'))\r",
              "        .to.include('/dashboard');\r",
              "});\r",
              "\r",
              "const cookie = pm.response.headers.get('Set-Cookie');\r",
              "if (cookie) pm.collectionVariables.set('session_cookie', cookie);"
